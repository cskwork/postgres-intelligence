# postgres-intelligence - Database Configuration
# Copy this file to .env and fill in real credentials.
# The .env file is ignored by git and loaded only by scripts.

# ===== DATABASE CONNECTION 1 =====
DB1_HOST=localhost
DB1_PORT=5432
DB1_USER=your_username
DB1_PASSWORD=your_password
DB1_DATABASE=your_database
DB1_NAME=primary
DB1_SSLMODE=prefer
DB1_CONNECT_TIMEOUT=10
DB1_APPLICATION_NAME=postgres-intelligence

# Alternative: DSN form. If DB1_DSN is set, it takes precedence over host/port fields.
# DB1_DSN=postgresql://user:password@localhost:5432/database?sslmode=prefer

# ===== DATABASE CONNECTION 2 (Optional) =====
# DB2_HOST=localhost
# DB2_PORT=5432
# DB2_USER=your_username
# DB2_PASSWORD=your_password
# DB2_DATABASE=your_database
# DB2_NAME=analytics
# DB2_SSLMODE=prefer
# DB2_CONNECT_TIMEOUT=10
# DB2_APPLICATION_NAME=postgres-intelligence

# Notes:
# - At least DB1 must be configured.
# - DB1..DB10 are supported.
# - DATABASE is required for PostgreSQL query execution.
# - NAME is used by query_executor.py --db <name>.

